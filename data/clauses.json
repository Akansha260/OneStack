[
  {"id": "MASTER-1.1", "doc": "policy_master_v1.md", "clause": "1.1", "authority": "master", "topic": "settlement",
   "text": "Settlement for UPI transactions is T+1 (next working day). Working days exclude Sundays and bank holidays.",
   "values": {"upi_days": 1}, "effective_from": "2026-01-01", "effective_to": "2026-07-31", "superseded_by": "CIRC-A"},
  {"id": "MASTER-1.2", "doc": "policy_master_v1.md", "clause": "1.2", "authority": "master", "topic": "settlement",
   "text": "Card transactions settle T+2.",
   "values": {"card_days": 2}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-1.3", "doc": "policy_master_v1.md", "clause": "1.3", "authority": "master", "topic": "settlement",
   "text": "If a settlement date falls on a bank holiday, settlement occurs on the next working day.",
   "values": {}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},

  {"id": "MASTER-2.1", "doc": "policy_master_v1.md", "clause": "2.1", "authority": "master", "topic": "mdr",
   "text": "UPI MDR for merchants with monthly volume up to ₹10 lakh is 0.30% of the transaction value.",
   "values": {"rate_small": "0.0030"}, "effective_from": "2026-01-01", "effective_to": "2026-07-31", "superseded_by": "CIRC-B"},
  {"id": "MASTER-2.2", "doc": "policy_master_v1.md", "clause": "2.2", "authority": "master", "topic": "mdr",
   "text": "UPI MDR for merchants with monthly volume above ₹10 lakh is 0.50% of the transaction value, subject to the cap in 2.3.",
   "values": {"rate_large": "0.0050"}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-2.3", "doc": "policy_master_v1.md", "clause": "2.3", "authority": "master", "topic": "mdr",
   "text": "MDR on any single UPI transaction shall not exceed ₹15.",
   "values": {"cap_small": "15", "cap_large": "15"}, "effective_from": "2026-01-01", "effective_to": "2026-07-31", "superseded_by": "CIRC-C"},
  {"id": "MASTER-2.4", "doc": "policy_master_v1.md", "clause": "2.4", "authority": "master", "topic": "mdr",
   "text": "GST at 18% is charged on the MDR amount and is not part of the MDR cap.",
   "values": {"gst_rate": "0.18"}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},

  {"id": "MASTER-3.1", "doc": "policy_master_v1.md", "clause": "3.1", "authority": "master", "topic": "refund",
   "text": "Merchants may initiate a refund within 90 days of the original transaction.",
   "values": {"refund_window_days": 90}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-3.2", "doc": "policy_master_v1.md", "clause": "3.2", "authority": "master", "topic": "refund",
   "text": "MDR charged on a refunded transaction is not returned to the merchant, except as provided in 3.3.",
   "values": {}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-3.3", "doc": "policy_master_v1.md", "clause": "3.3", "authority": "master", "topic": "refund",
   "text": "If a refund is initiated within 24 hours of the transaction, the MDR is reversed in full.",
   "values": {"reversal_window_hours": 24}, "effective_from": "2026-01-01", "effective_to": "2026-08-31", "superseded_by": "CIRC-D"},
  {"id": "MASTER-3.4", "doc": "policy_master_v1.md", "clause": "3.4", "authority": "master", "topic": "chargeback",
   "text": "Chargeback disputes must be raised by the customer's bank within 120 days.",
   "values": {"chargeback_days": 120}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},

  {"id": "MASTER-4.1", "doc": "policy_master_v1.md", "clause": "4.1", "authority": "master", "topic": "limits",
   "text": "Per-transaction UPI limit is ₹1,00,000.",
   "values": {"per_txn": "100000"}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-4.2", "doc": "policy_master_v1.md", "clause": "4.2", "authority": "master", "topic": "limits",
   "text": "Merchants in category \"Capital Markets\" and \"Insurance\" may accept up to ₹2,00,000 per transaction, see 4.4.",
   "values": {"per_txn_enhanced": "200000", "categories": ["capital markets", "insurance"]}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-4.3", "doc": "policy_master_v1.md", "clause": "4.3", "authority": "master", "topic": "limits",
   "text": "Daily limit per customer account is ₹1,00,000 across all UPI transactions.",
   "values": {"daily": "100000"}, "effective_from": "2026-01-01", "effective_to": "2026-07-31", "superseded_by": "CIRC-E"},
  {"id": "MASTER-4.4", "doc": "policy_master_v1.md", "clause": "4.4", "authority": "master", "topic": "limits",
   "text": "The enhanced limit in 4.2 applies only to merchants who have completed enhanced KYC (Annexure C).",
   "values": {}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},

  {"id": "MASTER-5.1", "doc": "policy_master_v1.md", "clause": "5.1", "authority": "master", "topic": "closure",
   "text": "A merchant may close the account with 30 days written notice.",
   "values": {"notice_days": 30}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},
  {"id": "MASTER-5.2", "doc": "policy_master_v1.md", "clause": "5.2", "authority": "master", "topic": "closure",
   "text": "Pending settlements are released within 10 working days of closure, after deducting outstanding dues.",
   "values": {"release_working_days": 10}, "effective_from": "2026-01-01", "effective_to": null, "superseded_by": null},

  {"id": "CIRC-A", "doc": "circular_2026_08_amendment.md", "clause": "A", "authority": "circular", "topic": "settlement", "replaces": "MASTER-1.1",
   "text": "Clause 1.1 is replaced: UPI settlement is T+0 (same day, by 11:59 PM) for merchants with an active \"Instant Settlement\" add-on, and T+1 for all others.",
   "values": {"upi_days_instant": 0, "upi_days": 1}, "effective_from": "2026-08-01", "effective_to": null, "superseded_by": null},
  {"id": "CIRC-B", "doc": "circular_2026_08_amendment.md", "clause": "B", "authority": "circular", "topic": "mdr", "replaces": "MASTER-2.1",
   "text": "Clause 2.1 is replaced: UPI MDR for merchants with monthly volume up to ₹10 lakh is 0.25%.",
   "values": {"rate_small": "0.0025"}, "effective_from": "2026-08-01", "effective_to": null, "superseded_by": null},
  {"id": "CIRC-C", "doc": "circular_2026_08_amendment.md", "clause": "C", "authority": "circular", "topic": "mdr", "replaces": "MASTER-2.3",
   "text": "Clause 2.3 is replaced: the MDR cap of ₹15 applies only to merchants with monthly volume up to ₹10 lakh. For merchants above ₹10 lakh, the cap is ₹25.",
   "values": {"cap_small": "15", "cap_large": "25"}, "effective_from": "2026-08-01", "effective_to": null, "superseded_by": null},
  {"id": "CIRC-D", "doc": "circular_2026_08_amendment.md", "clause": "D", "authority": "circular", "topic": "refund", "replaces": "MASTER-3.3",
   "text": "Clause 3.3 is deleted. Clause 3.2 now applies without exception. (Effective 01 September 2026.)",
   "values": {}, "effective_from": "2026-09-01", "effective_to": null, "superseded_by": null},
  {"id": "CIRC-E", "doc": "circular_2026_08_amendment.md", "clause": "E", "authority": "circular", "topic": "limits", "replaces": "MASTER-4.3",
   "text": "Clause 4.3 is amended: the daily limit per customer account is ₹1,00,000 or the limit set by the customer's own bank, whichever is lower.",
   "values": {"daily": "100000", "bank_limit_applies": true}, "effective_from": "2026-08-01", "effective_to": null, "superseded_by": null},

  {"id": "FAQ-SETTLEMENT", "doc": "merchant_faq_2026-03.md", "clause": "Q: When will I get my UPI money?", "authority": "faq", "topic": "settlement",
   "text": "Next working day. Card money comes in two working days.", "values": {}, "effective_from": "2026-03-12", "effective_to": null, "superseded_by": null},
  {"id": "FAQ-MDR", "doc": "merchant_faq_2026-03.md", "clause": "Q: What do I pay on a UPI transaction?", "authority": "faq", "topic": "mdr",
   "text": "0.30% for small merchants, 0.50% for large ones. There is no upper limit on the fee, so very large transactions cost more.", "values": {}, "effective_from": "2026-03-12", "effective_to": null, "superseded_by": null},
  {"id": "FAQ-REFUND", "doc": "merchant_faq_2026-03.md", "clause": "Q: If a customer asks for a refund the same day, do I get my fee back?", "authority": "faq", "topic": "refund",
   "text": "Yes, if you refund within 24 hours we reverse the fee.", "values": {}, "effective_from": "2026-03-12", "effective_to": null, "superseded_by": null},
  {"id": "FAQ-LIMITS", "doc": "merchant_faq_2026-03.md", "clause": "Q: What is the maximum amount a customer can pay at my shop?", "authority": "faq", "topic": "limits",
   "text": "₹1,00,000 per transaction. Insurance and capital markets merchants can accept ₹2,00,000.", "values": {}, "effective_from": "2026-03-12", "effective_to": null, "superseded_by": null},
  {"id": "FAQ-CLOSURE", "doc": "merchant_faq_2026-03.md", "clause": "Q: Can I close my account any time?", "authority": "faq", "topic": "closure",
   "text": "Yes, with 30 days' notice. Pending money is released within 10 days.", "values": {}, "effective_from": "2026-03-12", "effective_to": null, "superseded_by": null}
]
